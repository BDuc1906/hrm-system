using System;
using System.ComponentModel.DataAnnotations;

namespace HRCoreDB.DTOs
{
    public class LoginDto
    {
        [Required]
        [MaxLength(50)]
        public string Username { get; set; } = null!;

        [Required]
        public string Password { get; set; } = null!;
    }

