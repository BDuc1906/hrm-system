        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t xml:space="preserve">a) Kiến trúc phần mềm </w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="45DB8FA1">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Kiến trúc phần mềm là cấu trúc tổng thể của một hệ thống phần mềm, bao gồm các thành phần, mối quan hệ giữa các thành phần đó và các nguyên tắc chi phối việc thiết kế cũng như sự tiến hóa của hệ thống theo thời gian. Nói cách khác, kiến trúc phần mềm xác định các thành phần chính của hệ thống và cách chúng tương tác, phối hợp với nhau để cùng thực hiện các chức năng của hệ thống.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="1286B0CA">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Kiến trúc phần mềm có ba đặc điểm nổi bật:</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="4AE1B578">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Tập trung vào các quyết định ở tầm cao, tức những lựa chọn mang tính nền tảng, ảnh hưởng đến toàn bộ hệ thống.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="7D03B30C">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Khó thay đổi khi đã triển khai. Một khi hệ thống đã được xây dựng theo một kiến trúc nhất định, việc thay đổi sang kiến trúc khác đòi hỏi chi phí rất lớn, đôi khi phải làm lại từ đầu.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="09E6C60D">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Có tầm ảnh hưởng sâu rộng, tác động trực tiếp đến các thuộc tính phi chức năng như hiệu năng, khả năng mở rộng, độ tin cậy và bảo mật của toàn hệ thống, chứ không chỉ riêng một module nào.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="055ACC35">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Một số dạng kiến trúc phổ biến trong thực tế: kiến trúc 3 lớp (Presentation – Business – Data), kiến trúc Microservices, kiến trúc phân tán (Distributed Architecture), kiến trúc hướng sự kiện (Event-Driven), v.v.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="79FC4A65">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:i/>
          <w:iCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>1.1.2.</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Tại sao cần phải thiết kế kiến trúc phần mềm</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="4C1571E8">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t xml:space="preserve">b) Thiết kế phần mềm </w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="2B714635">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Nếu kiến trúc trả lời câu hỏi &quot;hệ thống gồm những gì và các phần lớn liên hệ với nhau ra sao&quot;, thì thiết kế phần mềm là bước đi sâu hơn: đó là quá trình xây dựng chi tiết cách thức triển khai cụ thể cho từng thành phần đã được xác định trong kiến trúc.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="01C02E6C">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Thiết kế phần mềm tập trung vào:</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="1E761FBF">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
    </w:p>
    <w:p w14:paraId="4B771819">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Mức độ module cụ thể trong hệ thống.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="479E580E">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Giao diện lập trình (API) giữa các module với nhau.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="5014CC9E">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Thuật toán xử lý bên trong từng chức năng.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="084E7890">
      <w:pPr>
