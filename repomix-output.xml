            v-model:value="form.dateRange"
            format="DD/MM/YYYY"
            :placeholder="['Ngày bắt đầu', 'Ngày kết thúc']"
            style="width: 100%"
          />
        </a-form-item>
        <a-form-item name="reason" label="Lý do">
          <a-textarea
            v-model:value="form.reason"
            :rows="3"
            placeholder="Nêu rõ lý do nghỉ phép..."
