          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Cấu trúc dữ liệu được sử dụng để lưu trữ và thao tác thông tin.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="42240A5D">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Ví dụ điển hình của thiết kế phần mềm: thiết kế Class Diagram cho một tính năng cụ thể (như tính năng đăng nhập, tính năng thanh toán), thiết kế giao diện người dùng (UI/UX) cho một màn hình chức năng.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="03D7410E">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>- Kiến trúc và thiết kế thường bị nhầm lẫn là một, nhưng thực chất đây là hai khái niệm khác nhau, thể hiện rõ qua nhiều tiêu chí.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="13E78D44">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>- Mức độ trừu tượng</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>: kiến trúc phần mềm ở mức cao, tập trung vào bức tranh tổng thể và cấu trúc lớn của hệ thống; trong khi đó thiết kế phần mềm ở mức trung bình đến thấp, đi sâu vào chi tiết bên trong từng module cụ thể.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="6AEE21BC">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>- Phạm vi:</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve"> kiến trúc bao trùm toàn bộ hệ thống, xác định các thành phần chính và cách chúng tương tác với nhau ở cấp độ vĩ mô. Thiết kế thì thu hẹp lại, chỉ xoay quanh từng module hoặc từng lớp riêng lẻ.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="52C336DD">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>- Mục tiêu:</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve"> kiến trúc hướng đến những thuộc tính mang tính dài hạn của hệ thống như khả năng mở rộng, khả năng bảo trì và hiệu năng tổng thể. Thiết kế lại hướng đến mục tiêu ngắn hạn và trực tiếp hơn — cài đặt được chức năng một cách hiệu quả và dễ hiểu.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="6800F502">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>- Thành phần mô tả:</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve"> kiến trúc quan tâm đến các thành phần chính, các kết nối giữa chúng và các mô hình tổng thể của hệ thống. Thiết kế lại đi vào giao diện lớp, thuật toán xử lý, cấu trúc dữ liệu và luồng xử lý nội bộ bên trong từng module.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="4294D9AE">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>- Tài liệu hóa:</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve"> kiến trúc được thể hiện qua các mô hình kiến trúc, sơ đồ cấp cao như sơ đồ triển khai hay sơ đồ thành phần. Thiết kế lại được tài liệu hóa bằng các sơ đồ chi tiết hơn như sơ đồ lớp, sơ đồ tuần tự, sơ đồ hoạt động.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="2EF3F889">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>- Người thực hiện:</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve"> kiến trúc thường do kỹ sư kiến trúc phần mềm đảm nhiệm, người có tầm nhìn tổng thể về hệ thống. Thiết kế thì do lập trình viên thiết kế thực hiện, dựa trên khung kiến trúc đã được xác định từ trước.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="6688F3E1">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>- Có thể hình dung mối quan hệ này theo hướng kiến trúc là bản vẽ tổng thể của tòa nhà: số tầng, kết cấu chịu lực, cách bố trí các khối chức năng. Thiết kế là bản vẽ chi tiết cho từng phòng trong tòa nhà đó: vị trí ổ điện, kích thước cửa, cách bố trí nội thất. Cả hai đều cần thiết và bổ sung cho nhau trong quá trình xây dựng một hệ thống phần mềm hoàn chỉnh — thiếu kiến trúc, hệ thống dễ mất phương hướng khi mở rộng; thiếu thiết kế chi tiết, kiến trúc dù tốt đến đâu cũng không thể chuyển thành sản phẩm chạy được trong thực tế.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="0EF07CE2">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Mối quan hệ giữa kiến trúc phần mềm với các giai đoạn khác trong quy trình phát triển</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="2E7187D9">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Kiến trúc phần mềm không tồn tại độc lập mà xuyên suốt và chi phối các giai đoạn khác của quy trình phát triển phần mềm:</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="5C7D3932">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Phân tích yêu cầu</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">: </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>kiến trúc được đề xuất ngay từ giai đoạn này để đáp ứng đồng thời cả yêu cầu chức năng lẫn yêu cầu phi chức năng (hiệu năng, bảo mật, khả năng mở rộng...) mà hệ thống cần đạt được.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="4BE477CD">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Cài đặt</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">: </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>như đã nêu ở mục trước, thiết kế chi tiết được xây dựng dựa trên kiến trúc chính là cơ sở trực tiếp để lập trình viên viết code.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="7F215009">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve">- </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Kiểm thử</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:b/>
          <w:bCs/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t>:</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
          <w:lang w:val="en-US"/>
        </w:rPr>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>một kiến trúc rõ ràng, phân tách thành các thành phần độc lập sẽ hỗ trợ việc kiểm thử ở cả hai cấp độ: kiểm thử từng module (unit test) và kiểm thử toàn hệ thống.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="54EBF35C">
      <w:pPr>
        <w:pStyle w:val="10"/>
        <w:spacing w:line="336" w:lineRule="auto"/>
        <w:ind w:left="0"/>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="default" w:ascii="Times New Roman" w:hAnsi="Times New Roman"/>
          <w:sz w:val="26"/>
          <w:szCs w:val="26"/>
        </w:rPr>
        <w:t>Vận hành và bảo trì — kiến trúc tốt giúp hệ thống dễ mở rộng khi có nhu cầu phát triển thêm, dễ khắc phục lỗi khi phát sinh sự cố, và dễ tích hợp với các hệ thống hoặc dịch vụ khác về sau.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="7F6D8C48">
