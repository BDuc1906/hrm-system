              >Tổng cộng</a-table-summary-cell
            >
            <a-table-summary-cell
              :index="4"
              style="font-weight: 700; color: var(--color-primary); font-size: 15px"
              >{{ formatCurrency(totalNet) }}</a-table-summary-cell
            >
            <a-table-summary-cell :index="5" />
