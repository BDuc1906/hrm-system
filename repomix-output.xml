# vốn là nguyên nhân dotnet format báo lỗi trên CI nhưng không thấy gì ở local.
* text=auto eol=lf

*.cs      text eol=lf
*.csproj  text eol=lf
*.sln     text eol=lf
*.slnx    text eol=lf
*.json    text eol=lf
*.js      text eol=lf
*.vue     text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf

# File nhị phân — không đụng vào line ending
*.png     binary
*.jpg     binary
*.ico     binary
*.dll     binary
</file>

<file path=".gitignore">
# Node.js
node_modules/
dist/
npm-debug.log
yarn-error.log

# .NET / C#
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
appsettings.Development.json
appsettings.Production.json

# IDEs / OS
.vscode/
.vs/
.idea/
*.DS_Store
Thumbs.db

# Docker
.dockerignore
!docker-compose.yml
!Dockerfile

# Environment variables
.env
.env.*
!.env.example
</file>

