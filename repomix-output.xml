]

async function onLogin() {
  loading.value = true
  errorMsg.value = ''
  try {
    await auth.login(form.username, form.password)
    message.success('Đăng nhập thành công!')
    const redirect = route.query.redirect || '/app/dashboard'
    router.push(redirect)
